# --- WEBSITE & INDEXNOW CONFIGURATION ---
BASE_URL=https://aidigitools.tech
INDEXNOW_KEY=89d63ab53a63527b12a199a3096e51ad

# --- GOOGLE CLOUD & SERVICE ACCOUNT / WORKLOAD IDENTITY ---
GOOGLE_CLOUD_PROJECT_ID=aidigitools-content-agent
GCP_SERVICE_ACCOUNT_EMAIL=content-agent-sa@aidigitools-content-agent.iam.gserviceaccount.com
# For GitHub Actions Workload Identity Federation (Keyless Auth)
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/123456789012/locations/global/workloadIdentityPools/github-pool/providers/github-provider
# For local development service account key fallback (path to JSON file or raw JSON string)
GSC_SERVICE_ACCOUNT_KEY=

# --- GOOGLE SEARCH CONSOLE & GOOGLE ANALYTICS 4 ---
# Search Console property URL (exact match with Search Console property)
GSC_SITE_URL=https://aidigitools.tech/
# Numeric GA4 Property ID (e.g., 123456789, NOT the G-XXXXXX measurement ID)
GA4_PROPERTY_ID=
# GA4 Web Stream Measurement ID (installed in HTML head)
GA4_MEASUREMENT_ID=G-NE094X2Q7H

# --- MICROSOFT BING WEBMASTER TOOLS ---
# Generated from Bing Webmaster Tools > Settings > API Access > API Key
BING_WEBMASTER_API_KEY=

# --- GOOGLE PAGESPEED INSIGHTS & CRUX API ---
# Dedicated API keys restricted in Google Cloud Console
PAGESPEED_API_KEY=
CRUX_API_KEY=

# --- GOOGLE GEMINI API ---
# Dedicated API key from Google AI Studio (restricted to Generative Language API)
GEMINI_API_KEY=

# --- GOOGLE ADS API (KEYWORD PLANNER) ---
# Configured in project aidigitools-content-agent
GOOGLE_ADS_CUSTOMER_ID=2913849282
GOOGLE_ADS_MANAGER_ID=1826247360

# --- GOOGLE TRENDS & AUTOCOMPLETE SEARCH ENGINE ---
# Real-time search query discovery via Google Autocomplete & Bing Webmaster
GOOGLE_TRENDS_FALLBACK=active

